class Solution {
    public int scoreOfParentheses(String s) {
        Stack<Integer> stk = new Stack<>();
        stk.push(0);
        for (char ch : s.toCharArray()) {
            if (ch == '(') {
                stk.push(0);
            } else {
                int in = stk.pop();
                int curr = stk.pop();
                if (in == 0) {
                    curr++;
                } else {
                    curr += 2 * in;
                }
                stk.push(curr);
            }

        }
        return stk.pop();
    }
}
