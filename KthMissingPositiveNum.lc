class Solution {
    public int findKthPositive(int[] nums, int k) {
        int l=0,r=nums.length-1;
        int miss=1;
        while(l<=r){
            int mid=l+(r-l)/2;
            if(nums[mid]-(mid+1)<k){
                l=mid+1;
            }
            else{
                r=mid-1;
            }
        }
        return l+k;
    }
}
