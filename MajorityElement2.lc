class Solution {
    public List<Integer> majorityElement(int[] nums) {
        int n=nums.length;
        Map<Integer,Integer> hm=new HashMap<>();
        for(int num:nums){
            hm.put(num,hm.getOrDefault(num,0)+1);
        }
        List<Integer> al=new ArrayList<>();
        int limit=n/3;
        for(Map.Entry<Integer,Integer> e:hm.entrySet()){
            int item=e.getKey();
            int cnt=e.getValue();
            if(cnt>limit){
                al.add(item);
            }
        }
        return al;
    }
}
